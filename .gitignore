# The kit ships the METHOD, not anyone's drafts or data.
# Keep personal writing, data, and generated setups out of the shared repo.

# OS / editor cruft
.DS_Store
__pycache__/
*.pyc
*.swp
.idea/
.vscode/

# Never commit an author's actual work through this repo
drafts/
# ignore author data dropped under data/ ...
data/*
# ... but keep the shipped third-party word lists (AVL, ACL)
!data/academic-vocab/
# AWL is CC BY-NC-ND (no derivatives): fetched locally by tools/vocab/fetch_awl.py, never committed
data/academic-vocab/awl_families.tsv
*.docx
*.pdf
# (none shipped, but allow if an example ever needs one)
!examples/**/*.pdf

# Filled-in personal setups (these belong in the author's own project, not here)
VOICE_PROFILE.md
venue-notes.md
skeleton.md
# keep the blank templates and the worked example
!templates/**
!examples/**
